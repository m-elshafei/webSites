# Docker knobs. Copy into your Laravel .env (they share one file).
#   cp .env.docker.example .env

COMPOSE_PROJECT_NAME=laravel-app

# --- image versions (bump here, nowhere else) --------------------------------
PHP_VERSION=8.5
NODE_VERSION=24
NGINX_VERSION=1.30
REDIS_VERSION=8-alpine
MARIADB_VERSION=11.8          # only used by the opt-in local-db profile

# --- host ids: keeps bind-mounted files owned by you, not by root ------------
UID=1000
GID=1000

# --- published host ports (FORWARD_* never clash with Laravel's own vars) ----
APP_PORT=8050
VITE_PORT=5173
FORWARD_REDIS_PORT=63790
FORWARD_MAILPIT_PORT=8025
FORWARD_DB_PORT=33060         # local-db profile only

# --- the shared database stack lives on its own docker network ---------------
DB_NETWORK=databases_databases-network

# --- xdebug: off | debug | develop,debug -------------------------------------
XDEBUG_MODE=off

# =============================== Laravel =====================================
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8050

# Points at the shared MySQL container by hostname on DB_NETWORK.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025

VITE_DEV_HOST=localhost
